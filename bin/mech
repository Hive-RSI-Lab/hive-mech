#!/bin/sh
# mech inside the Hive: enclosures in code for KiCad boards. Keeps its Python
# venv (build123d, matplotlib, pytest) in the agent's own HOME and runs
# mech/cli.py with it.
#
#   mech board <x.kicad_pcb> [-o board.json]  outline, holes, parts, ports
#   mech build <enclosure.py> [-o DIR]        export STL/STEP, fit-check, render
#   mech fit <enclosure.py>                   the fit check alone
#   mech slice <part.stl ...> [--install]     PrusaSlicer: filament g, support, print time
#   mech onshape check|upload ...             the Onshape handoff (docs/onshape.md)
#   mech test [args]                          the module's tests
#   mech pin <clone> [--sha REV]              pin hifi-receiver's committed boards
#   mech score                                each pinned board, graded by the boxes that hold it
#   mech python [args]                        the venv's python, mech importable
#   mech env                                  print the exports
#
# test, score, build and fit (OCP models, renders, a whole suite) wait for
# `hive agent heavy`'s lease inside a Hive turn (at most 10 minutes, then run
# anyway): give the shell command a timeout to match.
#
# Nothing here installs anything outside HOME: the venv is built from
# requirements.lock with the Hive's uv on first use (a few minutes: OCP is big).
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
tools=${HIVE_TOOLS:-/hive/tools}
state=${MECH_HOME:-$HOME/.cache/mech}
venv=${MECH_VENV:-$state/venv}

if [ ! -x "$venv/bin/python" ] || [ "$here/requirements.lock" -nt "$venv/.mech-lock" ]; then
	uv=$(command -v uv || true)
	[ -z "$uv" ] && [ -x "$tools/uv/bin/uv" ] && uv=$tools/uv/bin/uv
	[ -z "$uv" ] && { echo "mech: needs uv (hive agent install --tool uv)" >&2; exit 127; }
	mkdir -p "$state"
	echo "mech: building the venv in $venv (first use)" >&2
	"$uv" venv -q --clear --python 3.12 "$venv" >&2
	VIRTUAL_ENV=$venv "$uv" pip install -q -r "$here/requirements.lock" >&2
	touch "$venv/.mech-lock"
fi
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
export MPLBACKEND=Agg

# A heavy command runs under `hive agent heavy`, which waits while the machine
# is strained and others run one: on 10-28 ten hwde suites, freerouting and a
# mech build at once took a 20-core load to 137. Not when it is already
# inside one (a test that runs mech) or the hive at hand has no heavy op yet:
# then it runs bare.
heavy=
x() {
	if [ -n "$heavy" ] && [ -z "${MECH_HEAVY_HELD:-}" ] && command -v hive >/dev/null 2>&1 &&
		hive agent help 2>/dev/null | grep -q '^  heavy '; then
		export MECH_HEAVY_HELD=1
		exec hive agent heavy --what "$heavy" -- "$@"
	fi
	[ -n "$heavy" ] && export MECH_HEAVY_HELD=1
	exec "$@"
}

case "${1:-}" in
env)
	printf "export PYTHONPATH='%s'\nexport MECH_PY='%s'\n" "$PYTHONPATH" "$venv/bin/python"
	;;
test)
	shift
	cd "$here"
	heavy="mech test (the module's pytest suite)"
	x "$venv/bin/python" -m pytest "$@"
	;;
python)
	shift
	exec "$venv/bin/python" "$@"
	;;
"" | -h | --help)
	sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'
	;;
*)
	case $1 in
	build | fit | score | slice) heavy="mech $1" ;;
	esac
	x "$venv/bin/python" -m mech.cli "$@"
	;;
esac
